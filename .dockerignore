# Keep the Docker build context lean (see Dockerfile: frontend + backend only).

# Source control & editor metadata
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp

# Local secrets — production env vars come from Fly secrets.
.env
.env.*
!.env.example

# Build output & caches (the image builds everything itself)
**/node_modules
**/build
**/dist
.gradle
**/.gradle
.kotlin
**/.kotlin
coverage
test-results
playwright-report
.pnpm-store

# Local data
uploads
.dev-data
/data

# Portable tool-chains kept next to the repo on developer machines
jdk21.zip
jdk-21.0.2/
pg.zip
pg/
gradle.zip
gradle-8.10/

# Logs & OS junk
*.log
.DS_Store

# Not needed in the image
docs/
graft/
e2e/
scripts/
playwright.config.ts
tsconfig.json
package.json
pnpm-lock.yaml
pnpm-workspace.yaml
.husky/
.github/
README.md
AGENTS.md
CLAUDE.md
GEMINI.md
