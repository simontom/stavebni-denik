# Stavební deník — environment variables template.
# Copy to `.env` for local development; production secrets are set
# directly in Fly.io (never commit `.env`).

# --- Database --------------------------------------------------------------
# Postgres 16. Use the unprivileged `app` role for the application
# (it has SELECT/INSERT/UPDATE/DELETE on most tables, but UPDATE/DELETE
# is REVOKEd on `audit_log`). Migrations run with a privileged role.
DATABASE_URL="postgresql://app:devpassword@localhost:5432/stavebni_denik?schema=public"

# --- Auth.js (next-auth) ---------------------------------------------------
# 32-byte random secret used to sign session cookies / CSRF tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-string-base64-encoded"
# Base URL the app is served from (used for callback URLs / cookies).
AUTH_URL="http://localhost:3000"

# --- File storage ----------------------------------------------------------
# Directory on the persistent volume where photos & exports live.
# In production this is the Fly volume mount: `/data`.
DATA_DIR="/data"

# --- Weather snapshot ------------------------------------------------------
# Open-Meteo base URL (no API key needed for the free tier).
# Override only for tests or self-hosted mirrors.
OPEN_METEO_BASE="https://api.open-meteo.com/v1"

# --- App metadata ----------------------------------------------------------
# Public app name shown in the UI / PDF header.
NEXT_PUBLIC_APP_NAME="Stavební deník"
# Default time zone for date formatting on the server.
TZ="Europe/Prague"

# --- Audit-log alerts (optional) -------------------------------------------
# SMTP credentials used by the daily integrity check (`pnpm verify:audit`,
# see .github/workflows/audit-verify.yml or a Fly machine schedule) to
# e-mail the BOSS when the hash chain is broken. When any required value
# (SMTP_HOST, SMTP_USER, SMTP_PASS, SMTP_FROM, ALERT_EMAIL) is missing,
# the check still runs and exits non-zero on tampering but skips the e-mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Stavební deník <alerts@example.com>"
# Recipient of integrity-failure alerts (the BOSS).
ALERT_EMAIL=""

# --- Sentry (optional) -----------------------------------------------------
# When SENTRY_DSN is empty, the SDK is fully no-op (no network traffic).
# Set to your project's DSN to start capturing server + edge exceptions.
SENTRY_DSN=""
# Defaults to NODE_ENV if not set. Use e.g. "production" / "staging".
SENTRY_ENVIRONMENT=""
# Fraction of transactions to sample for performance tracing (0.0–1.0).
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Optional release tag (commit SHA / git tag) — helps correlate errors
# with deploys in the Sentry UI.
SENTRY_RELEASE=""

# --- Backup (production-only, set via Fly secrets) -------------------------
# Restic repository URL (B2 / R2 / S3 / SFTP). Leave empty in local dev.
RESTIC_REPOSITORY=""
# Repository encryption password — KEEP SAFE: without it backups are
# permanently unrecoverable.
RESTIC_PASSWORD=""
# Backend credentials. Pick the right pair for your repository scheme:
#   B2:  B2_ACCOUNT_ID / B2_ACCOUNT_KEY
#   S3:  AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
B2_ACCOUNT_ID=""
B2_ACCOUNT_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
