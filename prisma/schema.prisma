// Prisma schema for stavebni-denik.
// Stage 1: minimal models (User, Session) needed for the deploy skeleton.
// Additional models (Project, DailyReport, Photo, AuditLog, ...) are added
// in later delivery stages per /Users/saymoon/.junie/plans/stavebni-denik-nextjs.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// `datasource.url` is configured in prisma.config.ts (Prisma 7+ style).
datasource db {
  provider = "postgresql"
}

enum Role {
  BOSS
  WORKER
  GUEST
}

model User {
  id            String    @id @default(cuid())
  nickname      String    @unique
  displayName   String
  passwordHash  String
  role          Role      @default(WORKER)
  // ČKAIT autorizační číslo stavbyvedoucího (povinné pro BOSS dle § 153 stavebního zákona).
  ckaitNumber   String?
  isActive      Boolean   @default(true)
  // Po prvním přihlášení vygenerovaným heslem musí uživatel heslo změnit.
  mustChangePwd Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  // Soft delete only — žádné tvrdé mazání uživatelů (audit-trail compliance).
  deletedAt     DateTime?

  sessions           Session[]
  // Zakázky, kde je tento uživatel stavbyvedoucím.
  projectsManaged    Project[]       @relation("ProjectSiteManager")
  // Členství uživatele v zakázkách (přístupový scope WORKER/GUEST).
  projectMemberships ProjectMember[]
  // Denní záznamy, fotky, připomínky a dodatky, které uživatel vytvořil.
  reportsAuthored    DailyReport[]   @relation("ReportAuthor")
  reportsSigned      DailyReport[]   @relation("ReportSigner")
  remarksAuthored    Remark[]        @relation("RemarkAuthor")
  addendaAuthored    Addendum[]      @relation("AddendumAuthor")
  photosUploaded     Photo[]         @relation("PhotoUploader")

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  // Volitelné info o klientovi pro audit/diagnostiku.
  ip        String?
  userAgent String?
  // Označení revokované session (logout / admin force-out).
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Zakázka (stavba) — identifikační údaje dle § 157 stavebního zákona
/// a přílohy č. 16 vyhlášky č. 499/2006 Sb. Vyplňují se jednou při založení.
/// Soft delete only přes `deletedAt` (= archiv, viditelný pro BOSS).
model Project {
  id            String    @id @default(cuid())
  // Identifikační údaje stavby (povinné).
  name          String
  address       String
  cadastralArea String
  parcelNumbers String
  // Volitelné / doplňující údaje.
  permitNumber  String?
  builder       String
  contractor    String
  // Stavbyvedoucí (musí být uživatel role BOSS s autorizací ČKAIT).
  siteManagerId String
  tdsName       String?
  bozpName      String?
  designerName  String?
  // GPS stavby pro snapshot počasí (Open-Meteo) v dalším kroku.
  gpsLat        Float?
  gpsLon        Float?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  // Soft delete only — archivace zakázky bez ztráty deníku.
  deletedAt     DateTime?

  siteManager User            @relation("ProjectSiteManager", fields: [siteManagerId], references: [id])
  members     ProjectMember[]
  reports     DailyReport[]

  @@index([deletedAt])
  @@index([siteManagerId])
  @@map("projects")
}

/// Přiřazení uživatele k zakázce — určuje přístupový scope pro WORKER/GUEST.
/// `role` je role uživatele *v rámci* dané zakázky (může se lišit od globální).
model ProjectMember {
  projectId String
  userId    String
  role      Role
  addedAt   DateTime @default(now())
  addedById String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// Denní záznam stavebního deníku (hlášení / „kontrolní den") dle § 157
/// stavebního zákona a přílohy č. 16 vyhlášky č. 499/2006 Sb.
/// Právně je vázán na jeden kalendářní den zakázky — odtud unique
/// `(projectId, date)`. Po podpisu se obsah uzamkne (`lockedAt`); další
/// změny jdou jen přes `Addendum` (errata). Soft delete přes `deletedAt`.
model DailyReport {
  id              String    @id @default(cuid())
  projectId       String
  // Den záznamu — půlnoc v Europe/Prague uložená jako UTC (viz lib/dates).
  date            DateTime
  authorId        String
  // Počet pracovníků po profesích: [{ "trade": "zedník", "count": 3 }, ...].
  workersByTrade  Json
  workDescription String
  // Volitelné textové položky deníku.
  materialsIn     String?
  machinery       String?
  testsAndChecks  String?
  safetyNotes     String?
  defects         String?
  otherNotes      String?
  // Snapshot počasí z Open-Meteo (nebo fallback `{ error, fetchedAt }`).
  // Nikdy se nepřepisuje — je součástí důkazního obsahu dne.
  weather         Json
  // Podpis a zámek (workflow v Kroku 6); sloupce zavedeny zde, aby se
  // pozdější krok obešel bez další migrace.
  signedAt        DateTime?
  signedById      String?
  lockedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?
  deletedAt       DateTime?

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User           @relation("ReportAuthor", fields: [authorId], references: [id])
  signedBy      User?          @relation("ReportSigner", fields: [signedById], references: [id])
  photos        Photo[]
  remarks       Remark[]
  materialNeeds MaterialNeed[]
  addenda       Addendum[]

  @@unique([projectId, date])
  @@index([deletedAt])
  @@index([authorId])
  @@map("daily_reports")
}

/// Fotka k dennímu záznamu. Originál se nedrží — uloží se zmenšená
/// verze (max 1920 px, JPEG q=82) a náhled (400 px) na `/data` volume,
/// metadata zde. Soubory servíruje jen auth-gated route.
model Photo {
  id           String    @id @default(cuid())
  reportId     String
  // Cesty relativní k DATA_DIR (např. "photos/{projectId}/{reportId}/{uuid}.jpg").
  pathOriginal String
  pathThumb    String
  width        Int
  height       Int
  bytes        Int
  // Z EXIF zachováno jen DateTimeOriginal a GPS (zbytek se strippuje).
  capturedAt   DateTime?
  gps          Json?
  uploadedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader User        @relation("PhotoUploader", fields: [uploadedById], references: [id])

  @@index([reportId])
  @@index([deletedAt])
  @@map("photos")
}

/// Připomínka TDS / koordinátora BOZP / projektanta ke dni. Píší ji
/// i GUEST/DOZOR uživatelé (jediná mutace, kterou role GUEST smí).
model Remark {
  id         String    @id @default(cuid())
  reportId   String
  authorId   String
  text       String
  // Oficiální (podepsaná) připomínka TDS při návštěvě — workflow v Kroku 6.
  isOfficial Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User        @relation("RemarkAuthor", fields: [authorId], references: [id])

  @@index([reportId])
  @@index([deletedAt])
  @@map("remarks")
}

/// Položka checklistu „materiál na další dny". Stav `resolved` označuje
/// vyřízenou položku (např. materiál dorazil).
model MaterialNeed {
  id           String    @id @default(cuid())
  reportId     String
  text         String
  neededBy     DateTime?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?
  deletedAt    DateTime?

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([deletedAt])
  @@map("material_needs")
}

/// Dodatek (errata) k podepsanému dennímu záznamu. Obsah dne se po
/// podpisu nemění; oprava se připojí jako dodatek a je rovněž auditována.
model Addendum {
  id        String   @id @default(cuid())
  reportId  String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  report DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User        @relation("AddendumAuthor", fields: [authorId], references: [id])

  @@index([reportId])
  @@map("addenda")
}

/// Sliding-window rate-limit storage (login throttle).
/// Append-only-ish: pravidelný garbage-collect při insertu (24 h cutoff).
model RateLimitAttempt {
  id        BigInt   @id @default(autoincrement())
  bucket    String
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bucket, key, createdAt])
  @@map("rate_limit_attempts")
}

/// Append-only audit log with a SHA-256 hash chain.
/// - Každá mutace v aplikaci prochází `withAudit()` (Prisma transakce).
/// - `prevHash` = `rowHash` předchozího řádku (nebo 64× '0' pro genesis).
/// - `rowHash`  = sha256(canonicalJSON(payload)).
/// - Postgres role `app` má INSERT/SELECT, ale REVOKED UPDATE/DELETE
///   (viz prisma/migrations/*_audit_log/migration.sql).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  ts         DateTime @default(now())
  actorId    String?  @map("actor_id")
  action     String // 'user.create', 'report.sign', ...
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  prevHash   String   @map("prev_hash")
  rowHash    String   @unique @map("row_hash")

  @@index([action, ts])
  @@index([entityType, entityId])
  @@index([actorId, ts])
  @@map("audit_log")
}
